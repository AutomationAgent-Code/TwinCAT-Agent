<UserControl x:Class="TwinCATAgent.Xae.TwinCATAgentChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid x:Name="Root">
        <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
        <TextBlock x:Name="Fallback" Margin="16" TextWrapping="Wrap"
                   Text="TwinCAT Agent 正在启动…"
                   Foreground="Gray" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
