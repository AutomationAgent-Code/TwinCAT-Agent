<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- Stable VSIX installation identity. Keep it unchanged so renamed
         TwinCATAgent.Xae assemblies upgrade the existing product. -->
    <Identity Id="TcCoAgent.6b6f9d1e-7c4e-4a6b-9e2d-1f0a5c8b3e21" Version="1.0.8.109" Language="en-US" Publisher="TwinCAT Agent" />
    <DisplayName>TwinCAT Agent</DisplayName>
    <Description xml:space="preserve">TwinCAT XAE 内的 AI 自动化开发助手。</Description>
  </Metadata>
  <Installation>
    <!-- TcXaeShell 15.0 exposes the VS Community-compatible extension host.
         This is the target used by the last known-good embedded package. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[15.0,16.0)">
      <ProductArchitecture>x86</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <!-- Match the compatibility range used by the XAE 15.0 VSIX host. -->
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[15.0,16.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
