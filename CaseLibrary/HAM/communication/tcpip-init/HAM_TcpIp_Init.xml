                  <xhtml xmlns="http://www.w3.org/1999/xhtml">FUNCTION_BLOCK FB_InitTCPIP
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	sSrvNetID 		: T_AmsNetID := '';(* TwinCAT TCP/IP server network address *)
	fbCloseAll		: FB_SocketCloseAll;
END_VAR
</xhtml>
                </InterfaceAsPlainText>
              </data>
            </addData>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* On PLC reset or program download close all created/opened sockets/connections *)
fbCloseAll( sSrvNetID := sSrvNetID, bExecute:= bInitTCPIP );
IF fbCloseAll.bBusy OR fbCloseAll.bError THEN
	RETURN;
END_IF
bInitTCPIP := FALSE;</xhtml>
          </ST>
