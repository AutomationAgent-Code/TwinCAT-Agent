(*
 * 功能：单电磁阀气缸（弹簧复位）—— 输出得电伸出、失电靠弹簧缩回
 * 来源：SPT Libraries / SOLID Components / Cylinder / Single Output
 * 说明：依赖 I_DigitalOutput【抽象】而非具体 FB（依赖倒置 DIP）。
 *       未注入输出时用内置空对象兜底，避免空引用。
 *       实例化写法：
 *         bValveVar AT %Q* : BOOL;
 *         fbValve   : FB_DigitalOutput(Output := bValveVar);
 *         fbCyl     : FB_CylinderSingleOutput(ExtendOutput := fbValve);
 *)
FUNCTION_BLOCK FB_CylinderSingleOutput IMPLEMENTS I_Cylinder
VAR
    ExtendOutput     : I_DigitalOutput;   // 注入的输出组件（抽象）

    // 空对象（Null Object）：未注入时的安全兜底
    NullEO           : BOOL;
    NullExtendOutput : FB_DigitalOutput(Output := NullEO);
END_VAR