Initialize := FALSE;
CASE DescendantSequenceState OF
    0:
        RegisterComponent(Component := {{AXIS_VAR}});
        CustomHoming.Position   := {{HOME_POS}};
        DescendantSequenceState := DescendantSequenceState + 10;

    10:
        IF SUPER^.Initialize() THEN
            DescendantSequenceState := DescendantSequenceState + 10;
        END_IF

    20:
        Initialize := TRUE;
END_CASE
