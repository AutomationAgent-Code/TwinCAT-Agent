// MC block is called EVERY scan (Execute=FALSE when idle) so its internal
// state machine advances and the edge is properly cleared for the next Start().
_fbMc(Axis := _refAxis, Execute := _bExecute,
      Position := _lrPosition, Velocity := _lrVelocity);

IF _bExecute THEN
    IF _fbMc.Done THEN
        Finish(bDone := TRUE, bError := FALSE, nErrId := 0);
    ELSIF _fbMc.Error THEN
        Finish(bDone := FALSE, bError := TRUE, nErrId := _fbMc.ErrorID);
    ELSIF _fbMc.CommandAborted THEN
        Finish(bDone := FALSE, bError := FALSE, nErrId := 0);
    END_IF
END_IF